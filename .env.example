# ============================================================
# ROLLTIME — konfigurasi
# Tanpa file .env → jalan dalam DEMO MODE (JSON file + disk lokal).
# Isi semua di bawah → otomatis switch ke Supabase + Telegram.
# ============================================================

# --- Supabase (database + auth) ---
# Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # service_role (secret, jangan di-front-end)

# --- Telegram (storage foto gratis, unlimited) ---
# 1) Chat ke @BotFather → /newbot → dapat token
# 2) Buat channel PRIVAT, jadikan bot sebagai admin (post permission)
# 3) Ambil chat id: kirim pesan ke channel, buka
#    https://api.telegram.org/bot<TOKEN>/getUpdates → "chat":{"id":-100...
TELEGRAM_BOT_TOKEN=123456:AAxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# --- Server ---
PORT=3000
