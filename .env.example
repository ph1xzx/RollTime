# ============================================================
# ROLLTIME — konfigurasi
# Tanpa .env → DEMO MODE (JSON file + disk lokal).
# Isi Supabase → DB beneran. Isi Telegram → storage unlimited.
# ============================================================

# --- Supabase (database + auth) ---
# Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # service_role (secret, jangan di-front-end)

# --- Storage foto (pilih SALAH SATU; tanpa keduanya = disk lokal/demo) ---
# OPSI A · Telegram — GRATIS UNLIMITED. Rekomendasi buat event gede.
# 1) @BotFather → /newbot → token
# 2) Buat channel privat, jadikan bot admin
# 3) Chat id: kirim pesan di channel → https://api.telegram.org/bot<TOKEN>/getUpdates
#    (atau forward pesan channel ke @userinfobot)
TELEGRAM_BOT_TOKEN=123456:AAxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# OPSI B · Supabase Storage — GRATIS 1GB (≈500-1000 foto). Paling simpel:
# cukup isi SUPABASE_* di atas, bucket "rolltime-photos" dibikin OTOMATIS.
# (Aktif otomatis kalau TELEGRAM_* tidak diisi. Ganti nama bucket kalau mau:)
# SUPABASE_STORAGE_BUCKET=rolltime-photos

# --- Server ---
PORT=3000
